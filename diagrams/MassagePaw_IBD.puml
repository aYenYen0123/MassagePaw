@startuml MassagePaw_IBD
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Monospace
skinparam defaultFontSize 11
skinparam shadowing false
skinparam componentStyle rectangle

title MassagePaw — Interconnection Diagram (SysMLv2)\npart HeadMassageTeleOpSystem — internal port bindings and item flows

' SysMLv2 interconnection diagram notation:
'   Boxes = part usages (instances inside the system)
'   Arrows = flow (item flows between ports)
'   = (equals sign) = bind (port binding)
'   Port labels match port def names from Ports package

component "opStation : OperatorStation" as OpSta {
  component "glove : OperatorGlove\n[IMUSensor×6, HapticActuator×10]" as Glove
  portin  "commandOut\n:TeleOpCommandPort" as opCmd
  portout "netOut\n:NetworkPort" as opNet
}

component "commsLink : TeleOpLink\n[UDP/RTP · AES-256 · ≤20ms]" as Link

component "robotHand : RobotHand" as Hand {
  component "netAdapter : NetworkAdapter\n[UDP/5G/WiFi6]" as NetAdapt
  component "computer : OnboardComputer\n[8-core · RT Linux]" as OBC
  component "safety : SafetyModule\n[force≤5N · watchdog100ms]" as Safety
  component "motorCtrl : MotorController\n[20ch · 1kHz]" as MC
  component "wristFTS : ForceTorqueSensor\n[6-DoF]" as FTS

  component "thumb : Thumb\n[4 JointActuator]" as Thumb
  component "index/middle/ring/pinky\n: Finger[4] × 3 JointActuator" as Fingers
  component "palm : Palm\n[TactileSensor×4]" as PalmT
  component "fingertips : Fingertip×5\n[TactileSensor each]" as FTips

  portin  "netIn\n:~NetworkPort" as robotNet
  portout "safetyOut→safetyIn bind" as safetyBind
}

' ── Item flows ────────────────────────────────────────────────────────────
Glove      --> opCmd     : OperatorPose\n(fused from IMU)
opCmd      --> Link      : item CommandPacket\n200 Hz
Link       --> robotNet  : item CommandPacket\n(encrypted)
robotNet   --> NetAdapt
NetAdapt   --> OBC       : item CommandPacket

OBC        --> Safety    : raw command
Safety     --> MC        : gated command\n(force_scale clamped)
MC         --> Thumb     : Angle[4] targets
MC         --> Fingers   : Angle[12] targets

Thumb      --> MC        : actualAngle + torque
Fingers    --> MC        : actualAngle + torque

FTips      --> OBC       : item HandState\n(pressureMap 500 Hz)
PalmT      --> OBC       : pressureMap\n500 Hz
FTS        --> OBC       : F/T 6-DoF\n1 kHz

OBC        --> NetAdapt  : item StatusPacket\n100 Hz
NetAdapt   --> Link      : item StatusPacket\n(encrypted)
Link       --> opCmd     : item StatusPacket
opCmd      --> Glove     : forceReading\n→ haptic vibration

' ── Port bindings ─────────────────────────────────────────────────────────
Safety     ..> OBC       : bind safetyOut = safetyIn\n(SafetyPort)
NetAdapt   ..> OBC       : bind netOut = netIn\n(NetworkPort)

note right of Safety
  <b>REQ-002</b>: maxContactForce = 5 N
  Incoming command force_scale
  clamped before forwarding to MC.
  accept ForceThresholdExceeded
  → SafetyHold state
end note

note right of OBC
  <b>REQ-005</b>: watchdogPeriod = 100 ms
  No CommandPacket > 100 ms
  → accept WatchdogTimeout
  → EmergencyStop state
end note

@enduml
