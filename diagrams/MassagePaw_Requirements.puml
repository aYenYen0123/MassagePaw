@startuml MassagePaw_Requirements
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Monospace
skinparam defaultFontSize 11
skinparam shadowing false

title MassagePaw — Requirement Diagram (SysMLv2)\nrequirement def + satisfy relationships (Verification package)

' SysMLv2 requirement notation:
'   requirement def <'ID'> Name { doc; subject; require constraint <name> { expr } }
'   satisfy Requirements::X by Parts::Y::attribute;   (in Verification package)

skinparam rectangle {
  BackgroundColor<<req>>     #D6EAF8
  BorderColor<<req>>         #2471A3
  BackgroundColor<<satisfy>> #D5F5E3
  BorderColor<<satisfy>>     #1E8449
  BackgroundColor<<part>>    #FDFEFE
  BorderColor<<part>>        #7D6608
}

rectangle "REQ-001\nTeleOpLatency\nlatency ≤ 20 ms\nsubject: TeleOpLink\nconstraint latencyOk" <<req>> as R1
rectangle "REQ-002\nMaxContactForce\nforce ≤ 5 N\nsubject: SafetyModule\nconstraint forceOk" <<req>> as R2
rectangle "REQ-003\nPositionResolution\nresolution ≤ 0.1°\nsubject: JointActuator\nconstraint resolutionOk" <<req>> as R3
rectangle "REQ-004\nTactileSampleRate\n≥ 200 Hz\nsubject: TactileSensor\nconstraint sampleOk" <<req>> as R4
rectangle "REQ-005\nWatchdogTimeout\n≤ 100 ms\nsubject: SafetyModule\nconstraint watchdogOk" <<req>> as R5
rectangle "REQ-006\nTotalHandMass\n≤ 1.0 kg\nsubject: RobotHand\nconstraint massOk" <<req>> as R6
rectangle "REQ-007\nDOFCount\n≥ 19\nsubject: RobotHand\nconstraint dofOk" <<req>> as R7
rectangle "REQ-008\nEncryptedComms\nAES-256\nsubject: TeleOpLink\nconstraint encryptionOk" <<req>> as R8

rectangle "TeleOpLink\n::maxLatency\nvalue = 20.0 ms" <<satisfy>> as S1
rectangle "SafetyModule\n::maxContactForce\nvalue = 5.0 N" <<satisfy>> as S2
rectangle "JointActuator\n::posResolution\nvalue = 0.05°" <<satisfy>> as S3
rectangle "TactileSensor\n::sampleRate\nvalue = 500 Hz" <<satisfy>> as S4
rectangle "SafetyModule\n::watchdogPeriod\nvalue = 100.0 ms" <<satisfy>> as S5
rectangle "RobotHand\n::totalMass\nvalue = 0.85 kg" <<satisfy>> as S6
rectangle "RobotHand\n::totalDOF\nvalue = 20" <<satisfy>> as S7
rectangle "TeleOpLink\n::encryption\n= AES_256" <<satisfy>> as S8

R1 <.. S1 : <<satisfy>>
R2 <.. S2 : <<satisfy>>
R3 <.. S3 : <<satisfy>>
R4 <.. S4 : <<satisfy>>
R5 <.. S5 : <<satisfy>>
R6 <.. S6 : <<satisfy>>
R7 <.. S7 : <<satisfy>>
R8 <.. S8 : <<satisfy>>

note bottom
  All satisfy relationships are declared in
  <b>package Verification</b> of RobotHandMassage.sysml:
    satisfy Requirements::TeleOpLatency by Parts::TeleOpLink::maxLatency;
    satisfy Requirements::MaxContactForce by Parts::SafetyModule::maxContactForce;
    ...
end note

@enduml
