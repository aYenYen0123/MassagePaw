@startuml MassagePaw_ROS2_Graph
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Monospace
skinparam defaultFontSize 11
skinparam shadowing false

title MassagePaw — ROS2 Node / Topic Graph (SysMLv2 Bridge)\n@ROS2Node / @ROS2Topic / @ROS2Service  metadata bindings

' Stereotypes match metadata def names in SysMLv2_ROS2_Bridge.sysml

skinparam component {
  BackgroundColor<<ROS2Node>>    #D6EAF8
  BorderColor<<ROS2Node>>        #2471A3
  BackgroundColor<<ROS2Topic>>   #D5F5E3
  BorderColor<<ROS2Topic>>       #1E8449
  BackgroundColor<<ROS2Service>> #FEF9E7
  BorderColor<<ROS2Service>>     #B7950B
  BackgroundColor<<external>>    #F2F3F4
  BorderColor<<external>>        #717D7E
}

' ── ROS2 nodes (@ROS2Node bindings) ───────────────────────────────────────
component "operator_station_node\n@ROS2Node\npart def ROS2_OperatorStation\n:> OperatorStation" <<ROS2Node>> as OpNode
component "safety_module_node\n@ROS2Node\npart def ROS2_SafetyModule\n:> SafetyModule" <<ROS2Node>> as SafeNode
component "robot_hand_node\n@ROS2Node\npart def ROS2_RobotHand\n:> RobotHand" <<ROS2Node>> as RobNode

component "robot_state_publisher" <<external>> as RSP
component "rviz2" <<external>> as Rviz
component "gazebo / gz_ros2_control" <<external>> as Gz

' ── Topics (@ROS2Topic bindings) ──────────────────────────────────────────
component "/teleop/command\n@ROS2Topic → ROS2_TeleOpCommandPort\n:> TeleOpCommandPort\nCommandPacket · reliable · 200 Hz" <<ROS2Topic>> as T1

component "/teleop/command_safe\n@ROS2Topic → ROS2_TeleOpCommandSafePort\n:> TeleOpCommandPort\nCommandPacket · reliable · 200 Hz" <<ROS2Topic>> as T2

component "/robot_hand/status\n@ROS2Topic → ROS2_HandStatusPort\n:> TeleOpCommandPort\nStatusPacket · reliable · 100 Hz" <<ROS2Topic>> as T3

component "/robot_hand/joint_states\n@ROS2Topic → ROS2_JointStatePort\n:> MechanicalJointPort\nsensor_msgs/JointState · sensor_data · 200 Hz" <<ROS2Topic>> as T4

component "/tf  /tf_static" <<ROS2Topic>> as T5

' ── Service (@ROS2Service binding) ────────────────────────────────────────
component "/robot_hand/set_mode\n@ROS2Service → ROS2_ModeTransitionPort\n:> SafetyPort\nmassage_paw/srv/SetMode" <<ROS2Service>> as S1

' ── Data flows ────────────────────────────────────────────────────────────
OpNode   --> T1        : publish
T1       --> SafeNode  : subscribe
SafeNode --> T2        : publish (force_scale clamped)
T2       --> RobNode   : subscribe

RobNode  --> T3        : publish
T3       --> OpNode    : subscribe
T3       --> SafeNode  : subscribe (watchdog)

RobNode  --> T4        : publish
T4       --> RSP       : subscribe
T4       --> Gz        : bridge

RSP      --> T5        : publish
T5       --> Rviz      : subscribe

' ── Service calls ─────────────────────────────────────────────────────────
OpNode   --> S1        : call (mode transition)
SafeNode --> S1        : call (ESTOP — watchdog/force)
S1       --> RobNode   : serve (FSM transition)

note bottom of T2
  <b>REQ-002</b> enforced here:
  @ROS2Param robot_hand.max_contact_force_n = 5.0
  Maps to SafetyModule::maxContactForce
end note

note bottom of S1
  FSM accept-then transitions
  served by robot_hand_node:
    IDLE → CALIBRATING
    CALIBRATING → TELEOP_ACTIVE
    TELEOP_ACTIVE → EMERGENCY_STOP
    SAFETY_HOLD → TELEOP_ACTIVE
    EMERGENCY_STOP → IDLE
end note

@enduml
