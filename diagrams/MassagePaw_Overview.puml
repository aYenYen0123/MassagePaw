@startuml MassagePaw_Overview
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Monospace
skinparam defaultFontSize 11
skinparam shadowing false

title MassagePaw — Definition Diagram (SysMLv2)\npart def hierarchy with ports and attributes

' ─── Stereotypes follow SysMLv2 keyword names ─────────────────────────────
' <<part def>>      structural definition
' <<item def>>      data / matter that flows
' <<port def>>      typed interaction point
' <<attribute def>> reusable value type
' <<enum def>>      enumeration

' ─────────────────────────────────────────────────────────────────────────
' VALUE TYPES
' ─────────────────────────────────────────────────────────────────────────
package "Values  {attribute def}" #EBF5FB {
  class Force       <<attribute def>> { value : Real; unit : String = "N" }
  class Torque      <<attribute def>> { value : Real; unit : String = "Nm" }
  class Angle       <<attribute def>> { value : Real; unit : String = "deg" }
  class Latency     <<attribute def>> { value : Real; unit : String = "ms" }
  class Frequency   <<attribute def>> { value : Real; unit : String = "Hz" }
  class Mass        <<attribute def>> { value : Real; unit : String = "kg" }
  class Pressure    <<attribute def>> { value : Real; unit : String = "kPa" }
}

' ─────────────────────────────────────────────────────────────────────────
' ENUMERATIONS
' ─────────────────────────────────────────────────────────────────────────
package "Enumerations  {enum def}" #FEF9E7 {
  class OperationMode   <<enum def>> { IDLE; CALIBRATING; TELEOP_ACTIVE;\nSAFETY_HOLD; EMERGENCY_STOP }
  class MassageTechnique <<enum def>> { EFFLEURAGE; PETRISSAGE; TAPOTEMENT;\nFRICTION; VIBRATION; SCALP_PRESS }
  class NetworkState    <<enum def>> { CONNECTED; DEGRADED; DISCONNECTED }
}

' ─────────────────────────────────────────────────────────────────────────
' PORT DEFINITIONS
' ─────────────────────────────────────────────────────────────────────────
package "Ports  {port def}" #E9F7EF {
  class MechanicalJointPort <<port def>> {
    in  flow commandAngle : Angle
    out flow actualAngle  : Angle
    out flow jointTorque  : Torque
  }
  class TeleOpCommandPort <<port def>> {
    in  flow poseCommand  : OperatorPose
    out flow systemStatus : SystemStatus
    out flow hapticReturn : Force
  }
  class NetworkPort <<port def>> {
    attribute maxLatency : Latency = 20 ms
    in  flow txData : CommandPacket
    out flow rxData : StatusPacket
  }
  class SafetyPort <<port def>> {
    out flow forceLimit    : Force
    out flow emergencyStop : Boolean
  }
  class HapticFeedbackPort <<port def>> {
    out flow forceReading : Force
    out flow pressureMap  : Pressure
  }
}

' ─────────────────────────────────────────────────────────────────────────
' ITEM DEFINITIONS
' ─────────────────────────────────────────────────────────────────────────
package "Items  {item def}" #F5EEF8 {
  class FingerJointState <<item def>> {
    fingerID   : Integer
    jointIndex : Integer
    angle      : Angle
    velocity   : AngularVel
    torque     : Torque
  }
  class HandState <<item def>> {
    timestamp    : Real
    joints       : FingerJointState[19]
    palmPressure : Pressure[16]
  }
  class OperatorPose <<item def>> {
    posX, posY, posZ   : Length
    orientW/X/Y/Z      : Real
    fingerAngles       : Angle[19]
    gripForce          : Force
  }
  class CommandPacket <<item def>> {
    sequenceNum : Integer
    timestamp   : Real
    pose        : OperatorPose
    technique   : MassageTechnique
    forceScale  : Real
  }
  class StatusPacket <<item def>> {
    sequenceNum : Integer
    handState   : HandState
    mode        : OperationMode
    batteryPct  : Real
    alerts      : String[*]
  }
}

' ─────────────────────────────────────────────────────────────────────────
' PART DEFINITIONS — Robot Side
' ─────────────────────────────────────────────────────────────────────────
package "Parts — Robot Hand  {part def}" #FDFEFE {

  class JointActuator <<part def>> {
    peakTorque    : Torque    = 1.2 Nm
    maxAngle      : Angle     = 90°
    posResolution : Angle     = 0.05°
    -- ports --
    mechanicalOut : ~MechanicalJointPort
  }

  class TactileSensor <<part def>> {
    resolution  : Integer = 8 taxels/cm²
    maxPressure : Pressure = 100 kPa
    sampleRate  : Frequency = 500 Hz
    -- ports --
    feedbackOut : HapticFeedbackPort
  }

  class Fingertip <<part def>> {
    material : String = silicone_gel_shore_20A
    radius   : Length = 8 mm
  }

  class FingerLink <<part def>> {
    length : Length
    mass   : Mass
  }

  class Finger <<part def>> {
    fingerID : Integer
    -- parts --
    proxLink : FingerLink  {length=45mm}
    midLink  : FingerLink  {length=30mm}
    distLink : FingerLink  {length=22mm}
    tip      : Fingertip
    mcpJoint : JointActuator
    pipJoint : JointActuator
    dipJoint : JointActuator
  }

  class Thumb <<part def>> {
    -- parts --
    proxLink    : FingerLink  {length=38mm}
    distLink    : FingerLink  {length=28mm}
    tip         : Fingertip
    cmcJoint    : JointActuator
    mcpJoint    : JointActuator
    ipJoint     : JointActuator
    abductJoint : JointActuator
  }

  class Palm <<part def>> {
    length : Length = 95 mm
    width  : Length = 85 mm
    mass   : Mass   = 0.12 kg
    -- parts --
    tactileArray : TactileSensor[4]
  }

  class WristAssembly <<part def>> {
    flexionRange   : Angle = 80°
    pronationRange : Angle = 180°
    -- parts --
    flexJoint : JointActuator
    rotJoint  : JointActuator
  }

  class SafetyModule <<part def>> {
    maxContactForce : Force   = 5 N
    watchdogPeriod  : Latency = 100 ms
    -- ports --
    safetyOut : SafetyPort
  }

  class OnboardComputer <<part def>> {
    cpuCores   : Integer = 8
    osRealtime : Boolean = true
    -- ports --
    safetyIn : ~SafetyPort
    netIn    : ~NetworkPort
  }

  class MotorController <<part def>> {
    channels : Integer = 20
    loopRate : Frequency = 1 kHz
  }

  class NetworkAdapter <<part def>> {
    protocol   : String = UDP/5G/WiFi6
    maxLatency : Latency = 5 ms
    -- ports --
    netOut : NetworkPort
  }

  class ForceTorqueSensor <<part def>> {
    dof      : Integer = 6
    maxForce : Force   = 50 N
  }

  class RobotHand <<part def>> {
    totalDOF  : Integer = 20
    totalMass : Mass    = 0.85 kg
    -- parts --
    wrist, palm, thumb\nindexFinger..pinkyFinger
    motorCtrl, computer\nnetAdapter, wristFTS, safety
    -- binds --
    safety.safetyOut = computer.safetyIn
    netAdapter.netOut = computer.netIn
  }

  ' Composition
  RobotHand *-- WristAssembly
  RobotHand *-- Palm
  RobotHand *-- Thumb
  RobotHand *-- Finger          : [4]
  RobotHand *-- MotorController
  RobotHand *-- OnboardComputer
  RobotHand *-- NetworkAdapter
  RobotHand *-- ForceTorqueSensor
  RobotHand *-- SafetyModule

  Finger *-- FingerLink    : proxLink/midLink/distLink
  Finger *-- Fingertip
  Finger *-- JointActuator : mcp/pip/dip

  Thumb  *-- FingerLink    : proxLink/distLink
  Thumb  *-- Fingertip
  Thumb  *-- JointActuator : cmc/mcp/ip/abduct [4]

  Fingertip *-- TactileSensor
  Palm      *-- TactileSensor : [4]
  WristAssembly *-- JointActuator : flex/rot [2]

  SafetyModule ..> OnboardComputer : bind safetyOut→safetyIn
  NetworkAdapter ..> OnboardComputer : bind netOut→netIn
}

' ─────────────────────────────────────────────────────────────────────────
' PART DEFINITIONS — Operator Side
' ─────────────────────────────────────────────────────────────────────────
package "Parts — Operator Station  {part def}" #FEF9E7 {

  class IMUSensor <<part def>> {
    dof        : Integer = 9
    sampleRate : Frequency = 200 Hz
  }

  class HapticActuator <<part def>> {
    actuatorType : String = LRA_vibrotactile
    frequency    : Frequency = 200 Hz
    maxForce     : Force = 2 N
  }

  class OperatorGlove <<part def>> {
    -- parts --
    fingerIMU   : IMUSensor[5]
    palmIMU     : IMUSensor
    wristIMU    : IMUSensor
    hapticArray : HapticActuator[10]
    -- ports --
    commandOut : TeleOpCommandPort
  }

  class OperatorStation <<part def>> {
    -- parts --
    glove, display, audio, netAdapter
    -- ports --
    commandOut : TeleOpCommandPort
    netOut     : NetworkPort
  }

  OperatorStation *-- OperatorGlove
  OperatorStation *-- NetworkAdapter
  OperatorGlove   *-- IMUSensor      : [6]
  OperatorGlove   *-- HapticActuator : [10]
}

' ─────────────────────────────────────────────────────────────────────────
' TOP-LEVEL SYSTEM
' ─────────────────────────────────────────────────────────────────────────
package "System  {part def}" #E8F4FD {
  class HeadMassageTeleOpSystem <<part def>> {
    -- parts --
    robotHand : RobotHand
    opStation : OperatorStation
    commsLink : TeleOpLink
    -- connections --
    teleOpConn : TeleOpConnection
    netConn    : NetworkLink
  }

  class TeleOpLink <<part def>> {
    protocol   : String = UDP/RTP
    encryption : String = AES_256
    maxLatency : Latency = 20 ms
    minLatency : Latency = 1 ms
  }

  HeadMassageTeleOpSystem *-- RobotHand
  HeadMassageTeleOpSystem *-- OperatorStation
  HeadMassageTeleOpSystem *-- TeleOpLink
}

@enduml
