@startuml MassagePaw_UseCases
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Monospace
skinparam defaultFontSize 11
skinparam shadowing false

title MassagePaw — Use Case Diagram

left to right direction

actor Operator  as op
actor Recipient as re

rectangle "HeadMassageTeleOpSystem" {
  usecase "Calibrate System"              as UC1
  usecase "Perform Head Massage"          as UC2
  usecase "Emergency Stop"               as UC3
  usecase "Force Limit Violation\n(auto)" as UC4
  usecase "Adjust Technique\n(parameter)" as UC5
}

op --> UC1
op --> UC2
op --> UC3
op --> UC5
re --> UC2

UC2 .> UC1 : <<include>>
UC4 .> UC3 : <<include>>
UC2 ..> UC4 : <<extend>>\n[force > 5 N]
UC2 ..> UC5 : <<extend>>

note top of UC4
  Triggered automatically
  by SafetyModule node
  (SysMLv2 REQ-002)
end note

@enduml
